---
// Ana sayfaya özel karşılama bölümü (görsel ağırlıklı).
// Yalnızca index.mdx içinde kullanılır; ders sayfalarını etkilemez.
import { getCollection } from 'astro:content';
import { aylar } from '../aylar.mjs';

const docs = await getCollection('docs');
const norm = (id: string) => id.replace(/\/index$/, '');
const hazirSayisi = aylar.filter(([dir]) => {
  const ay = docs.find((d) => norm(d.id) === `program/${dir}`);
  return ay ? !ay.data.taslak : false;
}).length;
const yuzde = Math.round((hazirSayisi / aylar.length) * 100);
---

<section class="hero-ozel">
  <div class="metin">
    <span class="etiket">11–15 YAŞ · AİLE İÇİ</span>
    <h1>İslami eğitim<br /><span class="vurgu">evde</span>, sofrada, birlikte.</h1>
    <p class="alt">
      Haftalık dersler, Kur'an ezberi ve tecvid takibi, hikâye ödevleri ve puan sistemiyle
      12 aylık aile içi din eğitimi rehberi.
    </p>
    <div class="aksiyonlar">
      <a class="buton-birincil" href="/program/eylul/hafta-1/">İlk dersten başla</a>
      <a class="buton-ikincil" href="/kilavuz/">Kullanım kılavuzu</a>
    </div>
    <div class="istatistikler">
      <div><b>{aylar.length}</b><span>ay / modül</span></div>
      <div><b>48</b><span>hafta ders</span></div>
      <div><b>{hazirSayisi}</b><span>ay tam hazır</span></div>
    </div>
  </div>

  <div class="gorsel-alani">
    <img src="/aile-hero.jpg" alt="Aile birlikte Kur'an ve ders çalışıyor" width="1000" height="571" />
    <div class="yuzen-kart">
      <span>PROGRAM DURUMU</span>
      <strong>{hazirSayisi} / {aylar.length} ay hazır</strong>
      <div class="bar"><div style={`width:${yuzde}%`}></div></div>
    </div>
  </div>
</section>

<style>
  .hero-ozel {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
    background: #0d2b1f;
    color: #f4f1e6;
    margin: -2rem calc(50% - 50vw) 2.5rem;
    padding: 3.5rem max(1.5rem, calc(50vw - 34rem)) 3.5rem;
  }
  .etiket {
    display: block;
    color: #e8b84b;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.9rem;
  }
  h1 {
    font-family: var(--tema-baslik);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    font-weight: 700;
    color: #f4f1e6;
  }
  .vurgu { color: #e8b84b; }
  .alt {
    color: #c3d2c8;
    font-size: 1.02rem;
    line-height: 1.6;
    margin: 0 0 1.75rem;
    max-width: 34rem;
  }
  .aksiyonlar { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .buton-birincil, .buton-ikincil {
    display: inline-block;
    padding: 0.8rem 1.7rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none !important;
  }
  .buton-birincil { background: #e8b84b; color: #1a1206; }
  .buton-birincil:hover { background: #f4c866; }
  .buton-ikincil { background: #16402c; color: #f4f1e6; border: 1px solid rgba(255,255,255,.15); }
  .buton-ikincil:hover { background: #1a4d34; }
  .istatistikler { display: flex; gap: 2.5rem; flex-wrap: wrap; }
  .istatistikler b { display: block; font-size: 1.8rem; color: #e8b84b; font-weight: 800; }
  .istatistikler span { color: #a9c2ac; font-size: 0.85rem; }
  .gorsel-alani { position: relative; }
  .gorsel-alani img {
    width: 100%; height: auto; border-radius: 18px; display: block;
    box-shadow: 0 20px 50px rgba(0,0,0,.4);
  }
  .yuzen-kart {
    position: absolute; left: -1.25rem; bottom: -1.5rem;
    background: #123423; border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px; padding: 1rem 1.25rem; min-width: 11rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.4);
  }
  .yuzen-kart span {
    display: block; font-size: 0.65rem; font-weight: 700;
    letter-spacing: 0.06em; color: #e8b84b; margin-bottom: 0.3rem;
  }
  .yuzen-kart strong { display: block; font-size: 1.05rem; margin-bottom: 0.6rem; color: #f4f1e6; }
  .bar { height: 6px; background: #0a2118; border-radius: 999px; overflow: hidden; }
  .bar > div { height: 100%; background: #e8b84b; border-radius: 999px; }

  @media (max-width: 860px) {
    .hero-ozel { grid-template-columns: 1fr; text-align: center; padding-top: 2.5rem; }
    .alt { margin-inline: auto; }
    .aksiyonlar, .istatistikler { justify-content: center; }
    .yuzen-kart { left: 1rem; }
  }
</style>

